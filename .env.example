# ============================================================
#  StudyBuddy AI — Environment Variables Template
# ============================================================
#  1. Copy this file:   cp .env.example .env   (Mac/Linux)
#                       copy .env.example .env  (Windows)
#  2. Fill in your real values below
#  3. NEVER commit .env to version control!
# ============================================================

# ── Google Gemini AI ─────────────────────────────────────────
# Required: powers AI Tutor and Notes AI panel
# Get your free key: https://aistudio.google.com/app/apikey
# Tip: add a second key from a different Google account —
#      it will be used automatically if Key 1 hits quota.
VITE_GOOGLE_AI_API_KEY=your_gemini_api_key_here
VITE_GOOGLE_AI_API_KEY_2=your_second_gemini_api_key_here

# ── Firebase (Authentication only) ───────────────────────────
# Required: handles sign-up, sign-in, Google OAuth, password reset
# Get from: https://console.firebase.google.com
#   → Your Project → Project Settings → Your apps → Web app → Config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_APP_ID=1:your_app_number:web:your_app_id

# ── Supabase (Database, Storage, Realtime) ────────────────────
# Required: stores all app data (notes, tests, communities, profiles)
# Get from: https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://your_project_ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
